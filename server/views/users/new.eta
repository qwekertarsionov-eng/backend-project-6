<% layout("../layouts/application", { header: it.t("views.layouts.application.register") }) %>
<h1 class="page-title"><%= it.t('views.layouts.application.register') %></h1>
<% if (it.errors) { const errs = Array.isArray(it.errors) ? it.errors : Object.values(it.errors).flat().map((e) => (typeof e === 'object' && e !== null) ? e : { message: e }); %>
  <div role="alert" class="mb-4 rounded border border-red-300 bg-red-50 px-3 py-2 text-red-700">
    <ul class="list-disc space-y-1 pl-4"><% errs.forEach((e) => { %><li class="text-sm"><%= e.message ?? e %></li><% }) %></ul>
  </div>
<% } %>
<section class="card mx-auto grid max-w-2xl grid-cols-2 gap-8">
  <div class="flex items-center justify-center text-7xl">🏔️</div>
  <form class="space-y-3" action="/users" method="post">
    <label class="block">
      <span class="label"><%= it.t('views.users.firstName') %></span>
      <input class="field" name="data[firstName]" id="data_firstName" type="text" aria-label="<%= it.t('views.users.firstName') %>" value="<%= it.user?.firstName ?? '' %>">
    </label>
    <label class="block">
      <span class="label"><%= it.t('views.users.lastName') %></span>
      <input class="field" name="data[lastName]" id="data_lastName" type="text" aria-label="<%= it.t('views.users.lastName') %>" value="<%= it.user?.lastName ?? '' %>">
    </label>
    <label class="block">
      <span class="label"><%= it.t('views.users.email') %></span>
      <input class="field" name="data[email]" id="data_email" type="email" aria-label="<%= it.t('views.users.email') %>" value="<%= it.user?.email ?? '' %>">
    </label>
    <label class="block">
      <span class="label"><%= it.t('views.users.password') %></span>
      <input class="field" name="data[password]" id="data_password" type="password" aria-label="<%= it.t('views.users.password') %>">
    </label>
    <button type="submit" class="btn btn-primary"><%= it.t('views.users.new.submit') %></button>
  </form>
</section>
