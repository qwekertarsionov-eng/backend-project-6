<% layout("../layouts/application", { header: it.t("views.layouts.application.users") }) %>
<h1 class="page-title"><%= it.t('views.layouts.application.users') %></h1>
<table class="table">
  <thead>
    <tr>
      <th><%= it.t('views.users.id') %></th>
      <th><%= it.t('views.users.fullName') %></th>
      <th><%= it.t('views.users.email') %></th>
      <th><%= it.t('views.users.createdAt') %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (it.users && it.users.length) { %>
      <% it.users.forEach((user) => { %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.firstName %> <%= user.lastName %></td>
          <td><%= user.email %></td>
          <td><%= new Date(user.createdAt).toLocaleString() %></td>
          <td class="space-x-1">
            <% if (it.currentUser && Number(it.currentUser.id) === Number(user.id)) { %>
              <a class="btn btn-primary" href="<%= `/users/${user.id}/edit` %>"><%= it.t('views.users.edit.submit') %></a>
              <form action="<%= `/users/${user.id}?_method=DELETE` %>" method="post" style="display:inline">
                <input type="submit" value="<%= it.t('views.users.delete.submit') %>" class="btn btn-danger">
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="5"><%= it.t('views.users.index.empty') %></td>
      </tr>
    <% } %>
  </tbody>
</table>
