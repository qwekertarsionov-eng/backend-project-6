<!doctype html>
<html lang="<%= it.t('lang') %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= it.header ?? it.t('appName') %></title>
  <link rel="stylesheet" href="<%= it.assetPath('main.css') %>">
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
  <header class="bg-white">
    <nav class="mx-auto flex h-14 max-w-5xl items-center gap-5 px-4 text-sm">
      <a href="/" class="font-bold"><%= it.t('appName') %></a>
      <a href="/users"><%= it.t('views.layouts.application.users') %></a>
      <% if (it.isAuthenticated) { %>
        <a href="/statuses"><%= it.t('views.layouts.application.statuses') %></a>
        <a href="/labels"><%= it.t('views.layouts.application.labels') %></a>
        <a href="/tasks"><%= it.t('views.layouts.application.tasks') %></a>
        <span class="ml-auto"></span>
        <form action="/session?_method=DELETE" method="post">
          <button type="submit" class="cursor-pointer text-slate-700 hover:text-slate-900"><%= it.t('views.layouts.application.logout') %></button>
        </form>
      <% } else { %>
        <span class="ml-auto"></span>
        <a href="/session/new"><%= it.t('views.layouts.application.login') %></a>
        <a href="/users/new"><%= it.t('views.layouts.application.register') %></a>
      <% } %>
    </nav>
  </header>
  <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
    <% if (it.flash) { %>
      <% ['success', 'error', 'warning', 'info'].forEach((type) => { %>
        <% if (it.flash[type] && it.flash[type].length) { %>
          <% it.flash[type].forEach((msg) => { %>
            <div role="alert" class="mb-4 rounded border border-blue-300 bg-blue-50 px-3 py-2 text-blue-700"><%= msg %></div>
          <% }) %>
        <% } %>
      <% }) %>
    <% } %>
    <%~ it.body %>
  </main>
  <footer class="bg-slate-900 py-3 text-center text-xs text-white">© Hexlet Ltd, 2021</footer>
</body>
</html>
