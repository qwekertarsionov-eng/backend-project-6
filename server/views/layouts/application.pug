doctype html
html(lang="en" class="h-100")
  head
    title = t('appName')
    meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    // Подключаем Bootstrap через CDN, как требует ТЗ
    link(rel="stylesheet" href="https://jsdelivr.net")
  body(class="d-flex flex-column h-100 bg-light")
    header
      nav(class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm")
        div(class="container-fluid")
          a(class="navbar-brand fw-bold" href="/")= t('appName')
          button(class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent")
            span(class="navbar-toggler-icon")
          div(class="collapse navbar-collapse" id="navbarContent")
            ul(class="navbar-fluid navbar-nav me-auto mb-2 mb-lg-0")
              li(class="nav-item")
                a(class="nav-link" href="/users")= t('views.layouts.application.users')
            ul(class="navbar-nav ms-auto mb-2 mb-lg-0")
              li(class="nav-item")
                a(class="nav-link btn btn-outline-light me-2 px-3 text-white" href="/login")= t('views.layouts.application.login')
              li(class="nav-item")
                a(class="nav-link btn btn-primary px-3 text-white" href="/register")= t('views.layouts.application.register')

    main(class="flex-shrink-0 my-5")
      div(class="container")
        block content

    footer(class="footer mt-auto py-3 bg-white border-top")
      div(class="container text-center")
        span(class="text-muted") © 2026 Hexlet Task Manager
    
    script(src="https://jsdelivr.net")
