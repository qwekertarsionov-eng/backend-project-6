<% layout("../layouts/application", { header: it.t("views.tasks.index.title") }) %>
<h1 class="page-title"><%= it.t('views.tasks.index.title') %></h1>

<% if (it.isAuthenticated) { %>
  <a class="btn btn-primary mb-4" href="/tasks/new"><%= it.t('views.tasks.index.create') %></a>
<% } %>

<form class="card mb-5 grid grid-cols-3 gap-3" action="/tasks" method="get">
  <select class="field" name="statusId"><option value=""><%= it.t('views.tasks.filter.status') %></option>
    <% it.statuses?.forEach((s) => { %><option value="<%= s.id %>"<%= String(s.id) === it.filter?.statusId ? ' selected' : '' %>><%= s.name %></option><% }) %></select>
  <select class="field" name="executorId"><option value=""><%= it.t('views.tasks.filter.executor') %></option>
    <% it.users?.forEach((u) => { %><option value="<%= u.id %>"<%= String(u.id) === it.filter?.executorId ? ' selected' : '' %>><%= u.firstName %> <%= u.lastName %></option><% }) %></select>
  <select class="field" name="labelId"><option value=""><%= it.t('views.tasks.filter.label') %></option>
    <% it.labels?.forEach((l) => { %><option value="<%= l.id %>"<%= String(l.id) === it.filter?.labelId ? ' selected' : '' %>><%= l.name %></option><% }) %></select>
  <label class="col-span-3 text-sm"><input type="checkbox" name="isCreator" value="true"<%= it.filter?.isCreator === 'true' ? ' checked' : '' %>> <%= it.t('views.tasks.filter.isCreator') %></label>
  <button type="submit" class="btn btn-primary w-fit"><%= it.t('views.tasks.filter.submit') %></button>
</form>

<% if (it.tasks?.length) { %>
<table class="table">
  <thead><tr><th>ID</th><th><%= it.t('views.tasks.name') %></th><th><%= it.t('views.tasks.status') %></th><th><%= it.t('views.tasks.creator') %></th><th><%= it.t('views.tasks.executor') %></th><th><%= it.t('views.tasks.createdAt') %></th><th></th></tr></thead>
  <tbody><% it.tasks.forEach((t) => { %>
    <tr>
      <td><%= t.id %></td>
      <td><a class="text-blue-600" href="<%= `/tasks/${t.id}` %>"><%= t.name %></a></td>
      <td><%= t.status?.name ?? '' %></td>
      <td><%= t.creator ? `${t.creator.firstName} ${t.creator.lastName}` : '' %></td>
      <td><%= t.executor ? `${t.executor.firstName} ${t.executor.lastName}` : '' %></td>
      <td><%= new Date(t.createdAt).toLocaleString() %></td>
      <td class="space-x-1">
        <% if (it.isAuthenticated) { %>
          <a class="btn btn-primary" href="<%= `/tasks/${t.id}/edit` %>"><%= it.t('views.tasks.edit.submit') %></a>
          <% if (it.currentUser && Number(it.currentUser.id) === Number(t.creatorId)) { %>
            <form class="inline" action="<%= `/tasks/${t.id}?_method=DELETE` %>" method="post"><input type="submit" value="<%= it.t('views.tasks.delete.submit') %>" class="btn btn-danger"></form>
          <% } %>
        <% } %>
      </td>
    </tr>
  <% }) %></tbody>
</table>
<% } else { %>
<table class="table"><tbody><tr><td colspan="7"><%= it.t('views.tasks.index.empty') %></td></tr></tbody></table>
<% } %>
