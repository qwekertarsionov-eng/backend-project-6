<% layout("../layouts/application", { header: it.t("views.tasks.index.title") }) %>
<h1 class="my-4 text-2xl font-bold"><%= it.t('views.tasks.index.title') %></h1>

<div class="mb-4 rounded-lg bg-white p-4 shadow-sm">
  <form action="/tasks" method="get" class="flex flex-wrap items-end gap-4">
    <div class="min-w-40">
      <label for="statusId" class="block text-sm font-medium text-gray-700"><%= it.t('views.tasks.filter.status') %></label>
      <select id="statusId" name="statusId" class="mt-1 block w-full rounded border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none">
        <option value=""></option>
        <% it.statuses.forEach((status) => { %>
          <option value="<%= status.id %>"<%= String(status.id) === it.filter?.statusId ? ' selected' : '' %>><%= status.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="min-w-40">
      <label for="executorId" class="block text-sm font-medium text-gray-700"><%= it.t('views.tasks.filter.executor') %></label>
      <select id="executorId" name="executorId" class="mt-1 block w-full rounded border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none">
        <option value=""></option>
        <% it.users.forEach((user) => { %>
          <option value="<%= user.id %>"<%= String(user.id) === it.filter?.executorId ? ' selected' : '' %>><%= user.firstName %> <%= user.lastName %></option>
        <% }) %>
      </select>
    </div>
    <div class="min-w-40">
      <label for="labelId" class="block text-sm font-medium text-gray-700"><%= it.t('views.tasks.filter.label') %></label>
      <select id="labelId" name="labelId" class="mt-1 block w-full rounded border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none">
        <option value=""></option>
        <% it.labels.forEach((label) => { %>
          <option value="<%= label.id %>"<%= String(label.id) === it.filter?.labelId ? ' selected' : '' %>><%= label.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex items-end gap-3 pb-1">
      <label for="isCreator" class="flex items-center gap-2 text-sm font-medium text-gray-700">
        <input id="isCreator" name="isCreator" type="checkbox" value="true"<%= it.filter?.isCreator === 'true' ? ' checked' : '' %> class="h-4 w-4 rounded border-gray-300 text-blue-600">
        <%= it.t('views.tasks.filter.isCreator') %>
      </label>
      <button type="submit" class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"><%= it.t('views.tasks.filter.submit') %></button>
    </div>
  </form>
</div>

<% if (it.isAuthenticated) { %>
  <a href="/tasks/new" class="mb-3 inline-block rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"><%= it.t('views.tasks.index.create') %></a>
<% } %>

<div class="overflow-x-auto rounded-lg bg-white shadow-sm">
  <table class="min-w-full">
    <thead>
      <tr class="border-b border-gray-200 bg-gray-100">
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.tasks.id') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.tasks.name') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.tasks.status') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.tasks.creator') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.tasks.executor') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.tasks.createdAt') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.tasks.actions') %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% if (it.tasks && it.tasks.length) { %>
        <% it.tasks.forEach((task) => { %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm text-gray-900"><%= task.id %></td>
            <td class="px-4 py-3 text-sm text-gray-900">
              <a href="<%= `/tasks/${task.id}` %>" class="mr-2 font-medium text-blue-600 hover:text-blue-800"><%= task.name %></a>
              <% if (task.labels && task.labels.length) { %>
                <% task.labels.forEach((label) => { %>
                  <span class="mr-1 rounded bg-gray-200 px-2 py-0.5 text-xs font-medium text-gray-700"><%= label.name %></span>
                <% }) %>
              <% } %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-900"><%= task.status ? task.status.name : '' %></td>
            <td class="px-4 py-3 text-sm text-gray-900"><%= task.creator ? `${task.creator.firstName} ${task.creator.lastName}` : '' %></td>
            <td class="px-4 py-3 text-sm text-gray-900"><%= task.executor ? `${task.executor.firstName} ${task.executor.lastName}` : '' %></td>
            <td class="px-4 py-3 text-sm text-gray-600"><%= new Date(task.createdAt).toLocaleString() %></td>
            <td class="px-4 py-3">
              <div class="flex gap-2">
                <% if (it.isAuthenticated) { %>
                  <a href="<%= `/tasks/${task.id}/edit` %>" class="rounded bg-blue-600 px-3 py-1 text-sm font-medium text-white hover:bg-blue-700"><%= it.t('views.tasks.edit.submit') %></a>
                  <% if (it.currentUser && Number(it.currentUser.id) === Number(task.creatorId)) { %>
                    <form action="<%= `/tasks/${task.id}?_method=DELETE` %>" method="post" class="inline">
                      <input type="submit" value="<%= it.t('views.tasks.delete.submit') %>" class="rounded bg-red-600 px-3 py-1 text-sm font-medium text-white hover:bg-red-700">
                    </form>
                  <% } %>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7" class="px-4 py-4 text-center text-sm text-gray-500"><%= it.t('views.tasks.index.empty') %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>