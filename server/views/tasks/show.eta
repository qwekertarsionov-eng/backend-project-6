<% layout("../layouts/application", { header: it.t("views.tasks.show.title") }) %>
<h1 class="page-title"><%= it.task.name %></h1>
<section class="card grid grid-cols-[1fr_260px] gap-6">
  <p><%= it.task.description || it.t('views.tasks.noDescription') %></p>
  <aside class="space-y-2 text-sm">
    <p><span class="rounded bg-red-600 px-2 py-1 text-white"><%= it.task.status?.name ?? '' %></span></p>
    <p><%= it.t('views.tasks.labels') %>: <%= (it.task.labels ?? []).map((l) => l.name).join(', ') %></p>
    <p><%= it.t('views.tasks.creator') %>: <%= it.task.creator ? `${it.task.creator.firstName} ${it.task.creator.lastName}` : '' %></p>
    <p><%= it.t('views.tasks.executor') %>: <%= it.task.executor ? `${it.task.executor.firstName} ${it.task.executor.lastName}` : '' %></p>
    <p><%= it.t('views.tasks.createdAt') %>: <%= new Date(it.task.createdAt).toLocaleString() %></p>
    <div class="space-x-1 pt-2">
      <% if (it.isAuthenticated) { %>
        <a class="btn btn-primary" href="<%= `/tasks/${it.task.id}/edit` %>"><%= it.t('views.tasks.edit.submit') %></a>
        <% if (it.currentUser && Number(it.currentUser.id) === Number(it.task.creatorId)) { %>
          <form class="inline" action="<%= `/tasks/${it.task.id}?_method=DELETE` %>" method="post">
            <input type="submit" value="<%= it.t('views.tasks.delete.submit') %>" class="btn btn-danger">
          </form>
        <% } %>
      <% } %>
    </div>
  </aside>
</section>
