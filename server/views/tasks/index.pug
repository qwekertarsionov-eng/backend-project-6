extends ../layouts/application.pug

block content
  div(class="container-fluid flex-grow-1")
    h1(class="my-4")= t('views.tasks.index.title')
    div(class="p-4 mb-4 bg-light border rounded shadow-sm")
      form(action="/tasks" method="GET" class="row g-3 align-items-end")
        div(class="col-md-3")
          label(for="statusId" class="form-label")= t('views.tasks.filter.status')
          select(id="statusId" name="statusId" class="form-select")
            option(value="")
            each status in statuses
              option(value=status.id selected=(String(status.id) === filter.statusId))= status.name
              
        div(class="col-md-3")
          label(for="executorId" class="form-label")= t('views.tasks.filter.executor')
          select(id="executorId" name="executorId" class="form-select")
            option(value="")
            each user in users
              option(value=user.id selected=(String(user.id) === filter.executorId))= `${user.firstName} ${user.lastName}`
              
        div(class="col-md-3")
          label(for="labelId" class="form-label")= t('views.tasks.filter.label')
          select(id="labelId" name="labelId" class="form-select")
            option(value="")
            each label in labels
              option(value=label.id selected=(String(label.id) === filter.labelId))= label.name
              
        div(class="col-md-3 d-flex flex-column")
          div(class="form-check mb-2")
            input(id="isCreator" name="isCreator" type="checkbox" class="form-check-input" value="true" selected=(filter.isCreator === 'true'))
            label(for="isCreator" class="form-check-label")= t('views.tasks.filter.isCreator')
          input(type="submit" class="btn btn-primary w-100" value=t('views.tasks.filter.submit'))
    if isAuthenticated
      a(class="btn btn-primary mb-3" href="/tasks/new")= t('views.tasks.index.create')
    
    table(class="table table-striped table-hover shadow-sm bg-white rounded")
      thead(class="table-dark")
        tr
          th= t('views.tasks.id')
          th= t('views.tasks.name')
          th= t('views.tasks.status')
          th= t('views.tasks.creator')
          th= t('views.tasks.executor')
          th= t('views.tasks.createdAt')
          th= t('views.tasks.actions')
      tbody
        if tasks && tasks.length > 0
          each task in tasks
            tr
              td= task.id
              td
                a(href=`/tasks/${task.id}` class="me-2")= task.name
                if task.labels && task.labels.length > 0
                  each label in task.labels
                    span(class="badge bg-secondary me-1 small")= label.name
                a(href=`/tasks/${task.id}`)= task.name
              td= task.status ? task.status.name : ''
              td= task.creator ? `${task.creator.firstName} ${task.creator.lastName}` : ''
              td= task.executor ? `${task.executor.firstName} ${task.executor.lastName}` : ''
              td= new Date(task.createdAt).toLocaleString()
              td
                div(class="d-flex")
                  if isAuthenticated
                    a(class="btn btn-primary btn-sm me-2" href=`/tasks/${task.id}/edit`)= t('views.tasks.edit.submit')
                    if currentUser && task.creatorId === currentUser.id
                      form(action=`/tasks/${task.id}` method="POST")
                        input(type="hidden" name="_method" value="DELETE")
                        input(class="btn btn-danger btn-sm" type="submit" value=t('views.statuses.delete.submit'))
        else
          tr
            td(colspan="7" class="text-center text-muted py-4") No tasks found.
