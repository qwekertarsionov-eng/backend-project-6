<% layout("./layouts/application", { header: it.t("views.index.hello") }) %>
<section class="card max-w-3xl">
  <h1 class="text-4xl font-bold"><%= it.t('views.index.hello') %></h1>
  <p class="mt-3"><%= it.t('views.index.description') %></p>
  <a class="btn btn-primary mt-5" href="https://ru.hexlet.io"><%= it.t('views.index.more') %></a>
</section>
