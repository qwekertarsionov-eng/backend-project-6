<% layout("../layouts/application", { header: it.t("views.layouts.application.login") }) %>
<h1 class="my-4 text-2xl font-bold"><%= it.t('views.layouts.application.login') %></h1>
<form action="/session" method="post" class="mt-4 max-w-md space-y-4">
  <div>
    <label for="data_email" class="block text-sm font-medium text-gray-700"><%= it.t('views.users.email') %></label>
    <input id="data_email" name="data[email]" type="email" class="mt-1 block w-full rounded border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none">
  </div>
  <div>
    <label for="data_password" class="block text-sm font-medium text-gray-700"><%= it.t('views.users.password') %></label>
    <input id="data_password" name="data[password]" type="password" class="mt-1 block w-full rounded border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none">
  </div>
  <button type="submit" class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"><%= it.t('views.layouts.application.login') %></button>
</form>