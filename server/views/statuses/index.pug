extends ../layouts/application.pug

block content
  div(class="container-fluid flex-grow-1")
    h1(class="my-4")= t('views.statuses.index.title')
    a(class="btn btn-primary mb-3" href="/statuses/new")= t('views.statuses.index.create')
    
    table(class="table table-striped table-hover shadow-sm bg-white rounded")
      thead(class="table-dark")
        tr
          th= t('views.statuses.id')
          th= t('views.statuses.name')
          th= t('views.statuses.createdAt')
          th= t('views.statuses.actions')
      tbody
        if statuses && statuses.length > 0
          each status in statuses
            tr
              td= status.id
              td= status.name
              td= new Date(status.createdAt).toLocaleString()
              td
                // Блок действий: кнопки Edit и Delete
                div(class="d-flex")
                  a(class="btn btn-primary btn-sm me-2" href=`/statuses/${status.id}/edit`)= t('views.statuses.edit.submit')
                  form(action=`/statuses/${status.id}` method="POST" onsubmit="return confirm('Are you sure?')")
                    input(type="hidden" name="_method" value="DELETE")
                    input(class="btn btn-danger btn-sm" type="submit" value=t('views.statuses.delete.submit'))
        else
          tr
            td(colspan="4" class="text-center text-muted py-4") No statuses available.
