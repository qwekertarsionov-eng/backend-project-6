<% layout("../layouts/application", { header: it.t("views.statuses.index.title") }) %>
<h1 class="my-4 text-2xl font-bold"><%= it.t('views.statuses.index.title') %></h1>
<a href="/statuses/new" class="mb-3 inline-block rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"><%= it.t('views.statuses.index.create') %></a>
<div class="overflow-x-auto rounded-lg bg-white shadow-sm">
  <table class="min-w-full">
    <thead>
      <tr class="border-b border-gray-200 bg-gray-100">
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.statuses.id') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.statuses.name') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.statuses.createdAt') %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><%= it.t('views.statuses.actions') %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% if (it.statuses && it.statuses.length) { %>
        <% it.statuses.forEach((status) => { %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm text-gray-900"><%= status.id %></td>
            <td class="px-4 py-3 text-sm text-gray-900"><%= status.name %></td>
            <td class="px-4 py-3 text-sm text-gray-600"><%= new Date(status.createdAt).toLocaleString() %></td>
            <td class="px-4 py-3">
              <div class="flex gap-2">
                <a href="<%= `/statuses/${status.id}/edit` %>" class="rounded bg-blue-600 px-3 py-1 text-sm font-medium text-white hover:bg-blue-700"><%= it.t('views.statuses.edit.submit') %></a>
                <form action="<%= `/statuses/${status.id}?_method=DELETE` %>" method="post" class="inline">
                  <input type="submit" value="<%= it.t('views.statuses.delete.submit') %>" class="rounded bg-red-600 px-3 py-1 text-sm font-medium text-white hover:bg-red-700">
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4" class="px-4 py-4 text-center text-sm text-gray-500"><%= it.t('views.statuses.index.empty') %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>