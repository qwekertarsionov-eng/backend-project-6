<% layout("../layouts/application", { header: it.t("views.statuses.index.title") }) %>
<h1 class="page-title"><%= it.t('views.statuses.index.title') %></h1>
<a class="btn btn-primary mb-5" href="/statuses/new"><%= it.t('views.statuses.index.create') %></a>
<table class="table">
  <thead>
    <tr>
      <th><%= it.t('views.statuses.id') %></th>
      <th><%= it.t('views.statuses.name') %></th>
      <th><%= it.t('views.statuses.createdAt') %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (it.statuses && it.statuses.length) { %>
      <% it.statuses.forEach((s) => { %>
        <tr>
          <td><%= s.id %></td>
          <td><%= s.name %></td>
          <td><%= new Date(s.createdAt).toLocaleString() %></td>
          <td class="space-x-1">
            <a class="btn btn-primary" href="<%= `/statuses/${s.id}/edit` %>"><%= it.t('views.statuses.edit.submit') %></a>
            <form action="<%= `/statuses/${s.id}?_method=DELETE` %>" method="post" style="display:inline">
              <input type="submit" value="<%= it.t('views.statuses.delete.submit') %>" class="btn btn-danger">
            </form>
          </td>
        </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="4"><%= it.t('views.statuses.index.empty') %></td>
      </tr>
    <% } %>
  </tbody>
</table>
