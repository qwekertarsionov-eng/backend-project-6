<% layout("../layouts/application", { header: it.t("views.labels.edit.title") }) %>
<h1 class="page-title"><%= it.t('views.labels.edit.title') %></h1>
<% if (it.errors) { const errs = Array.isArray(it.errors) ? it.errors : Object.values(it.errors).flat().map((e) => (typeof e === 'object' && e !== null) ? e : { message: e }); %>
  <div role="alert" class="mb-4 rounded border border-red-300 bg-red-50 px-3 py-2 text-red-700">
    <ul class="list-disc space-y-1 pl-4"><% errs.forEach((e) => { %><li class="text-sm"><%= e.message ?? e %></li><% }) %></ul>
  </div>
<% } %>
<section class="card mx-auto max-w-2xl">
  <form class="space-y-3" action="<%= `/labels/${it.label.id}?_method=PATCH` %>" method="post">
    <label class="block">
      <span class="label"><%= it.t('views.labels.name') %></span>
      <input class="field" type="text" name="data[name]" id="data_name" value="<%= it.label?.name ?? '' %>">
    </label>
    <button type="submit" class="btn btn-primary"><%= it.t('views.labels.edit.submit') %></button>
  </form>
</section>
