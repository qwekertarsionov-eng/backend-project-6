<% layout("../layouts/application", { header: it.t("views.labels.edit.title") }) %>
<h1 class="my-4 text-2xl font-bold"><%= it.t('views.labels.edit.title') %></h1>
<% if (it.errors) { const errs = Array.isArray(it.errors) ? it.errors : Object.values(it.errors).flat().map((e) => (typeof e === 'object' && e !== null) ? e : { message: e }); %>
  <div role="alert" class="mt-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-red-800">
    <ul class="list-disc space-y-1 pl-4"><% errs.forEach((e) => { %><li class="text-sm"><%= e.message ?? e %></li><% }) %></ul>
  </div>
<% } %>
<form action="<%= `/labels/${it.label.id}?_method=PATCH` %>" method="post" class="mt-4 max-w-md space-y-4">
  <div>
    <label for="data_name" class="block text-sm font-medium text-gray-700"><%= it.t('views.labels.name') %></label>
    <input id="data_name" name="data[name]" type="text" value="<%= it.label?.name ?? '' %>" class="mt-1 block w-full rounded border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none">
  </div>
  <button type="submit" class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"><%= it.t('views.labels.edit.submit') %></button>
</form>