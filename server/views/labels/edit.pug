extends ../layouts/application.pug

block content
  div(class="container-fluid flex-grow-1")
    h1(class="my-4")= t('views.labels.edit.title')
    
    if errors
      div(class="alert alert-danger")
        ul
          each error in errors
            li= error.message

    form(action=`/labels/${label.id}` method="POST")
      input(type="hidden" name="_method" value="PATCH")
      div(class="mb-3")
        label(for="data_name")= t('views.labels.name')
        input(id="data_name" name="data[name]" class="form-control" type="text" value=(label ? label.name : ''))
      input(class="btn btn-primary" type="submit" value=t('views.labels.edit.submit'))
