<% layout("../layouts/application", { header: it.t("views.labels.index.title") }) %>
<h1 class="page-title"><%= it.t('views.labels.index.title') %></h1>
<a class="btn btn-primary mb-5" href="/labels/new"><%= it.t('views.labels.index.create') %></a>
<table class="table">
  <thead>
    <tr>
      <th><%= it.t('views.labels.id') %></th>
      <th><%= it.t('views.labels.name') %></th>
      <th><%= it.t('views.labels.createdAt') %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (it.labels && it.labels.length) { %>
      <% it.labels.forEach((l) => { %>
        <tr>
          <td><%= l.id %></td>
          <td><%= l.name %></td>
          <td><%= new Date(l.createdAt).toLocaleString() %></td>
          <td class="space-x-1">
            <a class="btn btn-primary" href="<%= `/labels/${l.id}/edit` %>"><%= it.t('views.labels.edit.submit') %></a>
            <form action="<%= `/labels/${l.id}?_method=DELETE` %>" method="post" style="display:inline">
              <input type="submit" value="<%= it.t('views.labels.delete.submit') %>" class="btn btn-danger">
            </form>
          </td>
        </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="4"><%= it.t('views.labels.index.empty') %></td>
      </tr>
    <% } %>
  </tbody>
</table>
