extends ../layouts/application.pug

block content
  div(class="container-fluid flex-grow-1")
    h1(class="my-4")= t('views.labels.index.title')
    a(class="btn btn-primary mb-3" href="/labels/new")= t('views.labels.index.create')
    
    table(class="table table-striped table-hover shadow-sm bg-white rounded")
      thead(class="table-dark")
        tr
          th= t('views.labels.id')
          th= t('views.labels.name')
          th= t('views.labels.createdAt')
          th= t('views.labels.actions')
      tbody
        if labels && labels.length > 0
          each label in labels
            tr
              td= label.id
              td= label.name
              td= new Date(label.createdAt).toLocaleString()
              td
                div(class="d-flex")
                  a(class="btn btn-primary btn-sm me-2" href=`/labels/${label.id}/edit`)= t('views.labels.edit.submit')
                  form(action=`/labels/${label.id}` method="POST" onsubmit="return confirm('Are you sure?')")
                    input(type="hidden" name="_method" value="DELETE")
                    input(class="btn btn-danger btn-sm" type="submit" value=t('views.labels.delete.submit'))
        else
          tr
            td(colspan="4" class="text-center text-muted py-4") No labels available.
